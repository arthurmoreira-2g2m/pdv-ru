<?xml version='1.0' encoding='utf-8'?>
<widget id="com.twogtwom.refeitorio.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>2G2M Refeitório</name>
    <description>Sistema Totem PDV de Acesso ao Refeitório 2G2M</description>
    <author email="suporte@2g2m.com" href="https://2g2m.com">2G2M Support</author>
    
    <content src="index.html" />
    
    <!-- Security and Access Rules -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="*" />
    
    <!-- VoltBuilder and Cordova Preferences -->
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="KeepRunning" value="true" />
    <preference name="ShowSplashScreen" value="false" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#ffffff" />

    <!-- Android Specific Permissions for Printing & Storage -->
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />

    <!-- Plugin nativo para abrir o diálogo de impressão do Android (Print Framework).
         TESTE: usado para verificar se a impressora do SK210 está exposta como
         Print Service padrão do Android, enquanto o SDK oficial da Gertec não
         está integrado — ver printerService.ts para detalhes. -->
    <plugin name="cordova-plugin-printer" spec="~0.8.0" />

    <!-- Hook que corrige os imports do cordova-plugin-printer para AndroidX
         (o pacote original ainda usa android.support.*, incompatível com
         builds Cordova Android atuais). Ver hooks/fix-printer-androidx.js -->
    <hook type="after_prepare" src="hooks/fix-printer-androidx.js" />
</widget>
